                        }
                    }
                },
                "settings": {
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "firstMatch": {
                        "value": true
                    },
                    "routes": {
                        "value": [
                            {
                                "expression": {
                                    "expression": true,
                                    "value": "$statusLine.statusCode == 200 && $entity.fidelityOfficeCode == 'HNKG'"
                                },
                                "outputViewName": {
                                    "value": "HNKG"
                                }
                            },
                            {
                                "expression": {
                                    "expression": true,
                                    "value": "($statusLine.statusCode >= 400 && $statusLine.statusCode < 500) || ($statusLine.statusCode == 200 && $entity.fidelityOfficeCode != 'HNKG')"
                                },
                                "outputViewName": {
                                    "value": "Non-HNKG"
                                }
                            },
